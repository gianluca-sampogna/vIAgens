# Supabase — projeto mglopitnyzobhiavosmw
SUPABASE_URL="https://mglopitnyzobhiavosmw.supabase.co"
# service_role: painel do Supabase -> Project Settings -> API Keys -> service_role
# ATENCAO: esta chave ignora RLS e da acesso total ao banco. Nunca no frontend,
# nunca commitada, nunca num arquivo que nao seja .env.
SUPABASE_SERVICE_ROLE_KEY=""

# Segredo de assinatura dos JWT — gere com: openssl rand -base64 32
JWT_SECRET=""
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# Precisa ser o MESMO client id usado pelo frontend
GOOGLE_CLIENT_ID=""

CORS_ORIGIN="http://localhost:3000"
PORT=3333
