# ============================================================================
# vIAgens — configuracao unica, lida pelo backend E pelo frontend.
# Fica na RAIZ do repositorio. Nao crie outro .env dentro de backend/ ou frontend/.
# ============================================================================

# ---------- Supabase (backend) ----------------------------------------------
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
# service_role: painel do Supabase -> Project Settings -> API Keys -> aba Legacy.
# ATENCAO: ignora RLS e da acesso total ao banco. Nunca no navegador, nunca
# commitada. Como este arquivo e lido pelo frontend tambem, NAO use o prefixo
# NEXT_PUBLIC_ nela: variaveis com esse prefixo vao para o bundle publico.
SUPABASE_SERVICE_ROLE_KEY=""

# ---------- Sessao (backend) ------------------------------------------------
# Segredo de assinatura dos JWT. Gere com: openssl rand -base64 32
JWT_SECRET=""
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# ---------- Login com Google (backend E frontend, o MESMO valor) ------------
# Console do Google Cloud -> Credenciais -> ID do cliente OAuth (app da Web).
# URI de redirecionamento autorizada: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------- Servidores ------------------------------------------------------
# Nao use "PORT": o Next.js le essa variavel e as portas colidiriam.
BACKEND_PORT="3333"
CORS_ORIGIN="http://localhost:3000"

# ---------- Frontend (NextAuth) ---------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=""
# Endereco do backend, visto pelo navegador. E publico por definicao.
NEXT_PUBLIC_API_URL="http://localhost:3333"
